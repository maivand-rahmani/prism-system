:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-stack { display: flex; gap: var(--{{SYSTEM_CLASS}}-spacing-semantic-stack); min-width: 0; }
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-stack-vertical { flex-direction: column; }
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-stack-horizontal { align-items: center; flex-direction: row; }
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-stack-wrap { flex-wrap: wrap; }
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-stack:is(ul,ol) { list-style: none; margin: 0; padding: 0; }
@media (max-width: 40rem) { :where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-stack-horizontal { align-items: stretch; flex-direction: column; } }
