:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-menu-content {
  animation: {{SYSTEM_CLASS}}-menu-in
    var(--{{SYSTEM_CLASS}}-motion-duration-fast)
    var(--{{SYSTEM_CLASS}}-motion-easing-standard);
  background: var(--{{SYSTEM_CLASS}}-color-surface-raised);
  border: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  border-radius: var(--{{SYSTEM_CLASS}}-radius-md);
  box-shadow: var(--{{SYSTEM_CLASS}}-shadow-md);
  min-width: 180px;
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-1);
  z-index: var(--{{SYSTEM_CLASS}}-layers-dropdown);
}
:where(
    .{{SYSTEM_CLASS}}-ui
  ).{{SYSTEM_CLASS}}-menu-content[data-state="closed"] {
  pointer-events: none;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-group {
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-1) 0;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-label {
  color: var(--{{SYSTEM_CLASS}}-color-text-muted);
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-xs);
  font-weight: var(--{{SYSTEM_CLASS}}-typography-weight-semibold);
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-scale-1);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-item {
  align-items: center;
  border-radius: var(--{{SYSTEM_CLASS}}-radius-sm);
  cursor: pointer;
  display: flex;
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-sm);
  gap: var(--{{SYSTEM_CLASS}}-spacing-scale-2);
  min-height: 32px;
  outline: 0;
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-scale-2);
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-menu-item:focus-visible {
  outline: 3px solid
    color-mix(
      in srgb,
      var(--{{SYSTEM_CLASS}}-color-border-focus) 38%,
      transparent
    );
  outline-offset: 2px;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-item:hover,
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-menu-item[data-highlighted] {
  background: var(--{{SYSTEM_CLASS}}-color-action-secondary);
  color: var(--{{SYSTEM_CLASS}}-color-action-primary-hover);
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-menu-item[data-disabled] {
  cursor: not-allowed;
  opacity: 0.45;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-indicator {
  color: var(--{{SYSTEM_CLASS}}-color-action-primary-hover);
  margin-left: auto;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-separator {
  background: var(--{{SYSTEM_CLASS}}-color-border-default);
  height: 1px;
  margin: var(--{{SYSTEM_CLASS}}-spacing-scale-1) 0;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-menu-arrow {
  fill: var(--{{SYSTEM_CLASS}}-color-surface-raised);
}
@keyframes {{SYSTEM_CLASS}}-menu-in {
  from {
    opacity: 0;
    transform: translateY(-2px) scale(0.99);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
