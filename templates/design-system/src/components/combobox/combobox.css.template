:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-combobox {
  position: relative;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-input {
  background: var(--{{SYSTEM_CLASS}}-color-surface-raised);
  border: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  border-radius: var(--{{SYSTEM_CLASS}}-radius-sm);
  color: var(--{{SYSTEM_CLASS}}-color-text-primary);
  min-height: calc(
    var(--{{SYSTEM_CLASS}}-spacing-scale-6) + var(--{{SYSTEM_CLASS}}-spacing-scale-4)
  );
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
  width: 100%;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-input::placeholder {
  color: var(--{{SYSTEM_CLASS}}-color-text-muted);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-input:focus-visible {
  border-color: var(--{{SYSTEM_CLASS}}-color-border-focus);
  box-shadow: var(--{{SYSTEM_CLASS}}-shadow-focus);
  outline: 0;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-input[aria-invalid="true"] {
  border-color: var(--{{SYSTEM_CLASS}}-color-status-danger);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-combobox-content {
  animation: {{SYSTEM_CLASS}}-combobox-enter
    var(--{{SYSTEM_CLASS}}-motion-duration-fast)
    var(--{{SYSTEM_CLASS}}-motion-easing-standard);
  background: var(--{{SYSTEM_CLASS}}-color-surface-raised);
  border: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  border-radius: var(--{{SYSTEM_CLASS}}-radius-md);
  box-shadow: var(--{{SYSTEM_CLASS}}-shadow-md);
  left: 0;
  max-height: var(--{{SYSTEM_CLASS}}-containers-narrow);
  min-width: min(100%, var(--{{SYSTEM_CLASS}}-containers-content));
  overflow: auto;
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-1);
  position: absolute;
  top: calc(100% + var(--{{SYSTEM_CLASS}}-spacing-scale-1));
  width: 100%;
  z-index: var(--{{SYSTEM_CLASS}}-layers-dropdown);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-combobox-content[hidden] {
  display: none;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-item {
  border-radius: var(--{{SYSTEM_CLASS}}-radius-sm);
  cursor: pointer;
  min-height: var(--{{SYSTEM_CLASS}}-spacing-scale-8);
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-combobox-item[data-active="true"],
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-item:hover {
  background: var(--{{SYSTEM_CLASS}}-color-action-secondary);
  color: var(--{{SYSTEM_CLASS}}-color-action-secondary-text);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-combobox-item[data-disabled] {
  cursor: not-allowed;
  opacity: 0.5;
}
:where(.{{SYSTEM_CLASS}}-ui) [data-slot="combobox-required-message"] {
  color: var(--{{SYSTEM_CLASS}}-color-status-danger);
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-xs);
}
@keyframes {{SYSTEM_CLASS}}-combobox-enter {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
