import * as React from "react";
import type { HeadingProps, HeadingLevel } from "@prism-system/ui-core";

export type { HeadingProps };
export const Heading = React.forwardRef<HTMLHeadingElement, HeadingProps>(function Heading(
  { level, className, ...props }, ref,
) {
  const Tag = `h${level}` as `h${HeadingLevel}`;
  return <Tag ref={ref} className={["{{SYSTEM_CLASS}}-ui", "{{SYSTEM_CLASS}}-heading", `{{SYSTEM_CLASS}}-heading-${level}`, className].filter(Boolean).join(" ")} {...props} />;
});
