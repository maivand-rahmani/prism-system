:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-file-upload {
  background: var(--{{SYSTEM_CLASS}}-color-surface-raised);
  border: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  border-radius: var(--{{SYSTEM_CLASS}}-radius-sm);
  color: var(--{{SYSTEM_CLASS}}-color-text-primary);
  min-height: calc(
    var(--{{SYSTEM_CLASS}}-spacing-scale-6) + var(--{{SYSTEM_CLASS}}-spacing-scale-4)
  );
  min-width: 0;
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-1);
  width: 100%;
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-file-upload::file-selector-button {
  background: var(--{{SYSTEM_CLASS}}-color-action-secondary);
  border: 0;
  border-radius: var(--{{SYSTEM_CLASS}}-radius-sm);
  color: var(--{{SYSTEM_CLASS}}-color-action-secondary-text);
  cursor: pointer;
  font: inherit;
  margin-inline-end: var(--{{SYSTEM_CLASS}}-spacing-scale-2);
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-file-upload:focus-visible {
  border-color: var(--{{SYSTEM_CLASS}}-color-border-focus);
  box-shadow: var(--{{SYSTEM_CLASS}}-shadow-focus);
  outline: 0;
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-file-upload[aria-invalid="true"] {
  border-color: var(--{{SYSTEM_CLASS}}-color-status-danger);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-file-upload:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}
