:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-aspect-ratio {
  min-width: 0;
  overflow: hidden;
  position: relative;
  width: 100%;
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-aspect-ratio > img,
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-aspect-ratio > video,
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-aspect-ratio > iframe {
  height: 100%;
  inset: 0;
  object-fit: cover;
  position: absolute;
  width: 100%;
}
