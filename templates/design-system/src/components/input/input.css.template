:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-field {
  display: grid;
  gap: var(--{{SYSTEM_CLASS}}-spacing-scale-2);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-label {
  color: var(--{{SYSTEM_CLASS}}-color-text-primary);
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-sm);
  font-weight: var(--{{SYSTEM_CLASS}}-typography-weight-semibold);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-hint,
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-error {
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-xs);
  line-height: var(--{{SYSTEM_CLASS}}-typography-line-height-normal);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-hint {
  color: var(--{{SYSTEM_CLASS}}-color-text-muted);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-error {
  color: var(--{{SYSTEM_CLASS}}-color-status-danger);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-control {
  align-items: center;
  background: var(--{{SYSTEM_CLASS}}-color-surface-raised);
  border: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  border-radius: var(--{{SYSTEM_CLASS}}-radius-sm);
  display: flex;
  min-height: 40px;
  transition:
    border-color var(--{{SYSTEM_CLASS}}-motion-duration-fast)
      var(--{{SYSTEM_CLASS}}-motion-easing-standard),
    box-shadow var(--{{SYSTEM_CLASS}}-motion-duration-fast)
      var(--{{SYSTEM_CLASS}}-motion-easing-standard);
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-control:focus-within {
  border-color: var(--{{SYSTEM_CLASS}}-color-border-focus);
  box-shadow: 0 0 0 3px
    color-mix(
      in srgb,
      var(--{{SYSTEM_CLASS}}-color-border-focus) 18%,
      transparent
    );
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-control-error {
  border-color: var(--{{SYSTEM_CLASS}}-color-status-danger);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-input {
  background: transparent;
  border: 0;
  color: var(--{{SYSTEM_CLASS}}-color-text-primary);
  flex: 1;
  min-width: 0;
  outline: 0;
  padding: var(--{{SYSTEM_CLASS}}-spacing-semantic-inline)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-input:focus-visible {
  outline: 3px solid
    color-mix(
      in srgb,
      var(--{{SYSTEM_CLASS}}-color-border-focus) 38%,
      transparent
    );
  outline-offset: 2px;
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-input::placeholder {
  color: var(--{{SYSTEM_CLASS}}-color-text-muted);
  opacity: 0.7;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-input:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-adornment {
  align-items: center;
  color: var(--{{SYSTEM_CLASS}}-color-text-muted);
  display: flex;
  padding: 0 var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-control-sm {
  min-height: 34px;
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-control-sm
  .{{SYSTEM_CLASS}}-input {
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-sm);
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-control-lg {
  min-height: 48px;
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-control-lg
  .{{SYSTEM_CLASS}}-input {
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-3)
    var(--{{SYSTEM_CLASS}}-spacing-scale-3);
}
