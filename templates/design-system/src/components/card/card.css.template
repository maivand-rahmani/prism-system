:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card {
  background: var(--{{SYSTEM_CLASS}}-color-surface-raised);
  border: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  border-radius: var(--{{SYSTEM_CLASS}}-radius-lg);
  color: var(--{{SYSTEM_CLASS}}-color-text-primary);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-elevated {
  border-color: transparent;
  box-shadow: var(--{{SYSTEM_CLASS}}-shadow-md);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-muted {
  background: var(--{{SYSTEM_CLASS}}-color-surface-sunken);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-outline {
  background: transparent;
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-interactive {
  cursor: pointer;
  transition:
    box-shadow var(--{{SYSTEM_CLASS}}-motion-duration-fast)
      var(--{{SYSTEM_CLASS}}-motion-easing-standard),
    transform var(--{{SYSTEM_CLASS}}-motion-duration-fast)
      var(--{{SYSTEM_CLASS}}-motion-easing-standard);
}
:where(
    .{{SYSTEM_CLASS}}-ui
  ).{{SYSTEM_CLASS}}-card-interactive:hover {
  box-shadow: var(--{{SYSTEM_CLASS}}-shadow-sm);
  transform: translateY(-1px);
}
:where(
  .{{SYSTEM_CLASS}}-ui
).{{SYSTEM_CLASS}}-card-padding-none {
  padding: 0;
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-padding-sm {
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-2);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-padding-md {
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-4);
}
:where(.{{SYSTEM_CLASS}}-ui).{{SYSTEM_CLASS}}-card-padding-lg {
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-6);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-card-header {
  display: grid;
  gap: var(--{{SYSTEM_CLASS}}-spacing-scale-1);
  padding: var(--{{SYSTEM_CLASS}}-spacing-semantic-inset)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inset) 0;
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-card-content {
  padding: var(--{{SYSTEM_CLASS}}-spacing-semantic-inset)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inset);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-card-footer {
  align-items: center;
  border-top: 1px solid var(--{{SYSTEM_CLASS}}-color-border-default);
  display: flex;
  gap: var(--{{SYSTEM_CLASS}}-spacing-semantic-inline);
  justify-content: flex-end;
  padding: var(--{{SYSTEM_CLASS}}-spacing-scale-3)
    var(--{{SYSTEM_CLASS}}-spacing-semantic-inset);
}
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-card-title {
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-md);
  font-weight: var(--{{SYSTEM_CLASS}}-typography-weight-semibold);
  letter-spacing: var(--{{SYSTEM_CLASS}}-typography-letter-spacing-tight);
  margin: 0;
}
:where(.{{SYSTEM_CLASS}}-ui)
  .{{SYSTEM_CLASS}}-card-description {
  color: var(--{{SYSTEM_CLASS}}-color-text-muted);
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-sm);
  line-height: var(--{{SYSTEM_CLASS}}-typography-line-height-normal);
  margin: 0;
}
