/* Icon presentation. Color is never set here: every glyph draws with
   `currentColor`, so the system's ink, status colors, and themes reach the icon
   through its surrounding component or text. */
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-icon {
  display: inline-block;
  flex: none;
  overflow: visible;
  transform-origin: center;
  vertical-align: -0.125em;
}

/* Opt-in motion for LoadingIcon. It is never applied by default, and reduced
   motion removes it entirely. */
:where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-icon-spin {
  animation: {{SYSTEM_CLASS}}-icon-spin 1s linear infinite;
}

@keyframes {{SYSTEM_CLASS}}-icon-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  :where(.{{SYSTEM_CLASS}}-ui) .{{SYSTEM_CLASS}}-icon-spin {
    animation: none;
  }
}
