:root {
  --{{SYSTEM_CLASS}}-canvas: #f6f7f8;
  --{{SYSTEM_CLASS}}-surface: #ffffff;
  --{{SYSTEM_CLASS}}-surface-muted: #eef0f2;
  --{{SYSTEM_CLASS}}-surface-raised: #ffffff;
  --{{SYSTEM_CLASS}}-ink: #20242a;
