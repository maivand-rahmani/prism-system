  --{{SYSTEM_CLASS}}-line: #d7dce1;
  --{{SYSTEM_CLASS}}-line-strong: #b9c1c9;
  --{{SYSTEM_CLASS}}-accent: #315f8f;
  --{{SYSTEM_CLASS}}-accent-strong: #24496f;
  --{{SYSTEM_CLASS}}-accent-soft: #e4edf6;
  --{{SYSTEM_CLASS}}-danger: #b53d48;
  --{{SYSTEM_CLASS}}-danger-soft: #f9e8ea;
  --{{SYSTEM_CLASS}}-focus: #4c8fd0;
  --{{SYSTEM_CLASS}}-on-accent: #ffffff;
  --{{SYSTEM_CLASS}}-radius-sm: 6px;
  --{{SYSTEM_CLASS}}-radius-md: 9px;
  --{{SYSTEM_CLASS}}-radius-lg: 13px;
