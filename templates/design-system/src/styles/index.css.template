/* Base scope. Every component root carries the package UI class, so the shared
   reset and typography live here rather than in any single component file. */
:where(.{{SYSTEM_CLASS}}-ui) {
  color: var(--{{SYSTEM_CLASS}}-color-text-primary);
  font-family: var(--{{SYSTEM_CLASS}}-typography-family-sans);
  font-size: var(--{{SYSTEM_CLASS}}-typography-size-md);
  line-height: var(--{{SYSTEM_CLASS}}-typography-line-height-normal);
}
:where(.{{SYSTEM_CLASS}}-ui) *,
:where(.{{SYSTEM_CLASS}}-ui) *::before,
:where(.{{SYSTEM_CLASS}}-ui) *::after {
  box-sizing: border-box;
}
:where(.{{SYSTEM_CLASS}}-ui) button,
:where(.{{SYSTEM_CLASS}}-ui) input,
:where(.{{SYSTEM_CLASS}}-ui) select,
:where(.{{SYSTEM_CLASS}}-ui) textarea {
  font: inherit;
}

@media (prefers-reduced-motion: reduce) {
  :where(.{{SYSTEM_CLASS}}-ui) *,
  :where(.{{SYSTEM_CLASS}}-ui) *::before,
  :where(.{{SYSTEM_CLASS}}-ui) *::after {
    animation-duration: var(
      --{{SYSTEM_CLASS}}-motion-duration-reduced
    ) !important;
    transition-duration: var(
      --{{SYSTEM_CLASS}}-motion-duration-reduced
    ) !important;
  }
}
