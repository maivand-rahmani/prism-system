{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maivand-rahmani/prism-system/schemas/design-system-source-v4.schema.json",
  "title": "Design System V4 Source Descriptor",
  "description": "The explicit, package-owned V4 API descriptor at packages/<id>/design-system.source.json (schemaVersion 2, contract \"v4\"). It declares the twenty required V4 components and only the optional components the system actually implements. Omitting an optional component means it is unavailable; there are no boolean false entries and no second capability list. Visual values are not stored here: semantic tokens live in the separate packages/<id>/tokens.source.json. It is a repository-only input and is not shipped in the tarball. scripts/design-system-manifest.mjs validates it and emits the shipped design-system.json.",
  "type": "object",
  "required": ["schemaVersion", "contract", "name", "components", "design", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema."
    },
    "schemaVersion": {
      "const": 2,
      "description": "V4 source-descriptor schema version."
    },
    "contract": {
      "const": "v4",
      "description": "The component contract the package implements."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing display name; cross-checked against prismSystem.name."
    },
    "components": {
      "type": "object",
      "description": "The twenty required V4 components plus only implemented optional components. Absence means the optional component is unavailable.",
      "required": [
        "Button",
        "Input",
        "Textarea",
        "Card",
        "Badge",
        "Checkbox",
        "RadioGroup",
        "Switch",
        "Select",
        "Tabs",
        "Dialog",
        "DropdownMenu",
        "Tooltip",
        "Separator",
        "Heading",
        "Text",
        "Link",
        "Container",
        "Stack",
        "FormField"
      ],
      "additionalProperties": false,
      "properties": {
        "Button": { "$ref": "#/$defs/component" },
        "Input": { "$ref": "#/$defs/component" },
        "Textarea": { "$ref": "#/$defs/component" },
        "Card": { "$ref": "#/$defs/component" },
        "Badge": { "$ref": "#/$defs/component" },
        "Checkbox": { "$ref": "#/$defs/component" },
        "RadioGroup": { "$ref": "#/$defs/component" },
        "Switch": { "$ref": "#/$defs/component" },
        "Select": { "$ref": "#/$defs/component" },
        "Tabs": { "$ref": "#/$defs/component" },
        "Dialog": { "$ref": "#/$defs/component" },
        "DropdownMenu": { "$ref": "#/$defs/component" },
        "Tooltip": { "$ref": "#/$defs/component" },
        "Separator": { "$ref": "#/$defs/component" },
        "Heading": { "$ref": "#/$defs/component" },
        "Text": { "$ref": "#/$defs/component" },
        "Link": { "$ref": "#/$defs/component" },
        "Container": { "$ref": "#/$defs/component" },
        "Stack": { "$ref": "#/$defs/component" },
        "FormField": { "$ref": "#/$defs/component" },
        "Grid": { "$ref": "#/$defs/component" },
        "Section": { "$ref": "#/$defs/component" },
        "Fieldset": { "$ref": "#/$defs/component" },
        "Alert": { "$ref": "#/$defs/component" },
        "Progress": { "$ref": "#/$defs/component" },
        "Skeleton": { "$ref": "#/$defs/component" },
        "Toast": { "$ref": "#/$defs/component" },
        "Accordion": { "$ref": "#/$defs/component" },
        "Avatar": { "$ref": "#/$defs/component" },
        "Breadcrumbs": { "$ref": "#/$defs/component" },
        "Pagination": { "$ref": "#/$defs/component" },
        "Table": { "$ref": "#/$defs/component" }
      }
    },
    "design": {
      "type": "object",
      "required": ["density", "theme", "radius", "keywords"],
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "theme": { "enum": ["light-first", "dark-first", "dual"] },
        "radius": { "enum": ["none", "small", "medium", "large", "full"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "allowArbitraryColors",
        "allowArbitraryRadius",
        "allowArbitraryShadows",
        "allowPrimitiveDuplication"
      ],
      "additionalProperties": false,
      "properties": {
        "allowArbitraryColors": { "type": "boolean" },
        "allowArbitraryRadius": { "type": "boolean" },
        "allowArbitraryShadows": { "type": "boolean" },
        "allowPrimitiveDuplication": { "type": "boolean" }
      }
    },
    "docs": {
      "type": "object",
      "description": "Optional package-relative documentation paths.",
      "required": ["readme", "agents"],
      "additionalProperties": false,
      "properties": {
        "readme": { "type": "string", "pattern": "^\\./.+" },
        "agents": { "type": "string", "pattern": "^\\./.+" },
        "brief": { "type": "string", "pattern": "^\\./.+" },
        "foundations": { "type": "string", "pattern": "^\\./.+" },
        "components": { "type": "string", "pattern": "^\\./.+" },
        "usage": { "type": "string", "pattern": "^\\./.+" }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["variants", "sizes", "members"],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sizes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "description": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 }
      }
    }
  }
}
