{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maivand-rahmani/prism-system/schemas/design-system.source.schema.json",
  "title": "Design System Source Descriptor",
  "description": "The explicit, package-owned API descriptor at packages/<id>/design-system.source.json. It declares each V2 component's variants, sizes, and compound members by hand so the generated manifest never infers them from CSS or fragile source regexes. It is a repository-only input and is not shipped in the tarball. scripts/design-system-manifest.mjs validates it and emits the shipped design-system.json.",
  "type": "object",
  "required": ["schemaVersion", "contract", "name", "components", "design", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Source-descriptor schema version. Bump when the shape changes."
    },
    "contract": {
      "const": "v2",
      "description": "The component contract the package implements. V2 is the only supported contract."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing display name; cross-checked against prismSystem.name."
    },
    "components": {
      "type": "object",
      "description": "Exactly the fourteen required V2 components, each with declared variants, sizes, and compound members.",
      "required": [
        "Button",
        "Input",
        "Textarea",
        "Card",
        "Badge",
        "Checkbox",
        "RadioGroup",
        "Switch",
        "Select",
        "Tabs",
        "Dialog",
        "DropdownMenu",
        "Tooltip",
        "Separator"
      ],
      "additionalProperties": false,
      "properties": {
        "Button": { "$ref": "#/$defs/component" },
        "Input": { "$ref": "#/$defs/component" },
        "Textarea": { "$ref": "#/$defs/component" },
        "Card": { "$ref": "#/$defs/component" },
        "Badge": { "$ref": "#/$defs/component" },
        "Checkbox": { "$ref": "#/$defs/component" },
        "RadioGroup": { "$ref": "#/$defs/component" },
        "Switch": { "$ref": "#/$defs/component" },
        "Select": { "$ref": "#/$defs/component" },
        "Tabs": { "$ref": "#/$defs/component" },
        "Dialog": { "$ref": "#/$defs/component" },
        "DropdownMenu": { "$ref": "#/$defs/component" },
        "Tooltip": { "$ref": "#/$defs/component" },
        "Separator": { "$ref": "#/$defs/component" }
      }
    },
    "design": {
      "type": "object",
      "required": ["density", "theme", "radius", "keywords"],
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "theme": { "enum": ["light-first", "dark-first", "dual"] },
        "radius": { "enum": ["none", "small", "medium", "large", "full"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "allowArbitraryColors",
        "allowArbitraryRadius",
        "allowArbitraryShadows",
        "allowPrimitiveDuplication"
      ],
      "additionalProperties": false,
      "properties": {
        "allowArbitraryColors": { "type": "boolean" },
        "allowArbitraryRadius": { "type": "boolean" },
        "allowArbitraryShadows": { "type": "boolean" },
        "allowPrimitiveDuplication": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["variants", "sizes", "members"],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sizes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
