{
  "$schema": "https://github.com/maivand-rahmani/prism-system/schemas/design-system.source.schema.json",
  "schemaVersion": 4,
  "contractVersion": 4,
  "name": "V4 Custom",
  "components": {
    "Button": {
      "variants": ["primary", "secondary", "ghost"],
      "sizes": ["sm", "md", "lg"],
      "members": [],
      "effects": {
        "features": ["depth", "motion"],
        "rendering": "dom",
        "reducedMotion": true
      }
    },
    "Input": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": []
    },
    "Textarea": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": []
    },
    "Card": {
      "variants": ["default", "outline"],
      "sizes": [],
      "members": ["Header", "Title", "Content", "Footer"]
    },
    "Badge": {
      "variants": ["default", "success", "danger"],
      "sizes": ["sm", "md"],
      "members": []
    },
    "Checkbox": {
      "variants": [],
      "sizes": ["sm", "md"],
      "members": []
    },
    "RadioGroup": {
      "variants": [],
      "sizes": [],
      "members": ["Item"]
    },
    "Switch": {
      "variants": [],
      "sizes": ["sm", "md"],
      "members": ["Thumb"]
    },
    "Select": {
      "variants": [],
      "sizes": ["sm", "md"],
      "members": ["Trigger", "Content", "Item"]
    },
    "Tabs": {
      "variants": [],
      "sizes": [],
      "members": ["List", "Trigger", "Content"]
    },
    "Dialog": {
      "variants": [],
      "sizes": [],
      "members": ["Trigger", "Content", "Title"]
    },
    "DropdownMenu": {
      "variants": [],
      "sizes": [],
      "members": ["Trigger", "Content", "Item"]
    },
    "Tooltip": {
      "variants": [],
      "sizes": [],
      "members": ["Provider", "Trigger", "Content"]
    },
    "Separator": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Heading": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": []
    },
    "Text": {
      "variants": ["body", "muted"],
      "sizes": [],
      "members": []
    },
    "Link": {
      "variants": ["default", "subtle"],
      "sizes": [],
      "members": []
    },
    "Container": {
      "variants": [],
      "sizes": ["narrow", "content", "wide", "full"],
      "members": []
    },
    "Stack": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "FormField": {
      "variants": [],
      "sizes": [],
      "members": ["Label", "Control", "Help", "Error"]
    },
    "Center": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Cluster": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Sidebar": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "AspectRatio": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Combobox": {
      "variants": [],
      "sizes": [],
      "members": ["Input", "Content", "Item"]
    },
    "DatePicker": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "NumberField": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Slider": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "FileUpload": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Grid": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Alert": {
      "variants": ["info", "success", "warning", "danger"],
      "sizes": [],
      "members": ["Title", "Description"],
      "effects": {
        "features": ["motion"],
        "rendering": "dom",
        "reducedMotion": true
      }
    }
  },
  "design": {
    "density": "comfortable",
    "theme": "dual",
    "radius": "medium",
    "keywords": ["calm", "editorial"]
  },
  "rules": {
    "allowArbitraryColors": false,
    "allowArbitraryRadius": false,
    "allowArbitraryShadows": false,
    "allowPrimitiveDuplication": false
  },
  "docs": {
    "readme": "./README.md",
    "agents": "./AGENTS.md"
  },
  "entrypoints": {
    "./custom/reveal": {
      "source": "./src/custom/reveal/index.ts",
      "requires": ["@prism-system/ui-core", "three"]
    },
    "./custom/keyboard-scene": {
      "source": "./src/custom/keyboard-scene/index.ts",
      "requires": ["three"]
    }
  },
  "extensions": {
    "Reveal": {
      "apiVersion": 1,
      "entrypoint": "./custom/reveal",
      "description": "Animated entrance wrapper with reduced-motion behavior.",
      "docs": "./docs/reveal.md",
      "example": "./examples/reveal.tsx",
      "effects": {
        "features": ["depth", "motion"],
        "rendering": "dom",
        "reducedMotion": true
      }
    },
    "KeyboardScene": {
      "apiVersion": 2,
      "entrypoint": "./custom/keyboard-scene",
      "description": "WebGL keyboard scene with a static fallback.",
      "docs": "./docs/keyboard-scene.md",
      "example": "./examples/keyboard-scene.tsx",
      "effects": {
        "features": ["3d", "motion"],
        "rendering": "webgl",
        "reducedMotion": true,
        "fallback": "static"
      }
    }
  }
}
