{
  "name": "@prism-system/ui-v2-valid",
  "version": "1.1.0",
  "description": "V2 validation fixture package.",
  "private": true,
  "prismSystem": {
    "name": "V2 Valid",
    "contract": "v2",
    "uiClass": "maivand-v2-valid-ui",
    "tokensExport": "v2ValidTokens"
  },
  "exports": {
