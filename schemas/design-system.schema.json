{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maivand-rahmani/prism-system/schemas/design-system.schema.json",
  "title": "Design System Manifest",
  "description": "The generated, shipped consumer manifest at packages/<id>/design-system.json. It is produced deterministically by scripts/design-system-manifest.mjs from the package-owned design-system.source.json, package.json, and design-brief.json. Do not edit it by hand: run `pnpm ds:manifest <id> --write` to regenerate. `package.json.version` is authoritative; the manifest version, the registry entry version, and the runtime DesignSystem.version must all match it.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "generated",
    "contract",
    "id",
    "name",
    "package",
    "version",
    "exports",
    "publicApi",
    "components",
    "design",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Generated-manifest schema version. Bump when the shape changes."
    },
    "generated": {
      "const": "prism-system/design-system-manifest",
      "description": "Generated marker identifying the emitting tool."
    },
    "contract": {
      "const": "v2",
      "description": "The component contract the package implements. V2 is the only supported contract."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Lower-kebab-case system id."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing display name."
    },
    "package": {
      "type": "string",
      "pattern": "^@prism-system/ui-[a-z0-9-]+$",
      "description": "npm package name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Exact package version, copied from package.json.version."
    },
    "exports": {
      "type": "object",
      "minProperties": 1,
      "description": "The package.json exports map, including the \"./manifest\" subpath that exposes this file.",
      "additionalProperties": true
    },
    "publicApi": {
      "type": "object",
      "description": "Declared public member names per code subpath. Validated against the package's actual public exports.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "object",
      "description": "The fourteen required V2 components with their declared variants, sizes, and compound members.",
      "required": [
        "Button",
        "Input",
        "Textarea",
        "Card",
        "Badge",
        "Checkbox",
        "RadioGroup",
        "Switch",
        "Select",
        "Tabs",
        "Dialog",
        "DropdownMenu",
        "Tooltip",
        "Separator"
      ],
      "additionalProperties": false,
      "properties": {
        "Button": { "$ref": "#/$defs/component" },
        "Input": { "$ref": "#/$defs/component" },
        "Textarea": { "$ref": "#/$defs/component" },
        "Card": { "$ref": "#/$defs/component" },
        "Badge": { "$ref": "#/$defs/component" },
        "Checkbox": { "$ref": "#/$defs/component" },
        "RadioGroup": { "$ref": "#/$defs/component" },
        "Switch": { "$ref": "#/$defs/component" },
        "Select": { "$ref": "#/$defs/component" },
        "Tabs": { "$ref": "#/$defs/component" },
        "Dialog": { "$ref": "#/$defs/component" },
        "DropdownMenu": { "$ref": "#/$defs/component" },
        "Tooltip": { "$ref": "#/$defs/component" },
        "Separator": { "$ref": "#/$defs/component" }
      }
    },
    "design": {
      "type": "object",
      "description": "Semantic design metadata (no token values).",
      "required": ["density", "theme", "radius", "keywords"],
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "theme": { "enum": ["light-first", "dark-first", "dual"] },
        "radius": { "enum": ["none", "small", "medium", "large", "full"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Strict usage rules a consumer must respect.",
      "required": [
        "allowArbitraryColors",
        "allowArbitraryRadius",
        "allowArbitraryShadows",
        "allowPrimitiveDuplication"
      ],
      "additionalProperties": false,
      "properties": {
        "allowArbitraryColors": { "type": "boolean" },
        "allowArbitraryRadius": { "type": "boolean" },
        "allowArbitraryShadows": { "type": "boolean" },
        "allowPrimitiveDuplication": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["variants", "sizes", "members"],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sizes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
