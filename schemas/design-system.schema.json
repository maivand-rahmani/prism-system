{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maivand-rahmani/prism-system/schemas/design-system.schema.json",
  "title": "Design System Manifest",
  "description": "The generated, shipped consumer manifest at packages/<id>/design-system.json (schemaVersion 5, contractVersion 4). It is produced deterministically by scripts/design-system-manifest.mjs from the package-owned design-system.source.json, tokens.source.json, package.json, and design-brief.json. It exposes the 29 required components and only the implemented optional components, the canonical capability-category inventory (`capabilities.categories`), flattened semantic token names (never token values), artifact paths, package-relative docs paths, a required `entrypoints` map with package.json-derived dependency/peer requirements, and optional nonempty `extensions` for custom PascalCase named exports. Do not edit it by hand: run `pnpm ds:manifest <id> --write` to regenerate. `package.json.version` is authoritative.",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "generated",
    "contractVersion",
    "id",
    "name",
    "package",
    "version",
    "exports",
    "publicApi",
    "entrypoints",
    "components",
    "capabilities",
    "design",
    "rules",
    "tokens",
    "docs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema."
    },
    "schemaVersion": {
      "const": 5,
      "description": "Generated-manifest schema version. The package-owned source descriptor is schemaVersion 4."
    },
    "generated": {
      "const": "prism-system/design-system-manifest",
      "description": "Generated marker identifying the emitting tool."
    },
    "contractVersion": {
      "const": 4,
      "type": "integer",
      "description": "The numeric component contract version the package implements. Only version 4 is supported."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Lower-kebab-case system id."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing display name."
    },
    "package": {
      "type": "string",
      "pattern": "^@prism-system/ui-[a-z0-9-]+$",
      "description": "npm package name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Exact package version, copied from package.json.version."
    },
    "exports": {
      "type": "object",
      "minProperties": 1,
      "description": "The package.json exports map, including the \"./manifest\" subpath that exposes this file.",
      "additionalProperties": true
    },
    "publicApi": {
      "type": "object",
      "description": "Declared public member names per code subpath. It covers exactly the `entrypoints` keys and is validated against the package's actual public exports.",
      "propertyNames": {
        "pattern": "^(?:\\.|\\./(?:[a-z0-9][a-z0-9-]*)(?:/[a-z0-9][a-z0-9-]*)*)$"
      },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "entrypoints": {
      "type": "object",
      "description": "The required public code entrypoint map: always \".\" and \"./tokens\" plus every declared additional code entrypoint. Each entry declares its requirements resolved from package.json metadata; an empty requirements list means no additional declared prerequisites, not the absence of ordinary package dependencies.",
      "required": [".", "./tokens"],
      "propertyNames": {
        "pattern": "^(?:\\.|\\./(?:[a-z0-9][a-z0-9-]*)(?:/[a-z0-9][a-z0-9-]*)*)$"
      },
      "additionalProperties": { "$ref": "#/$defs/entrypoint" }
    },
    "extensions": {
      "type": "object",
      "minProperties": 1,
      "description": "Optional nonempty map of verified custom PascalCase named exports, never canonical component names. Absence means the system ships no extensions; support is never assumed from a name alone.",
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/extension" }
    },
    "components": {
      "type": "object",
      "description": "The 29 required components plus only the optional components the system implements. Absence means unavailable.",
      "required": [
        "Button",
        "Input",
        "Textarea",
        "Card",
        "Badge",
        "Checkbox",
        "RadioGroup",
        "Switch",
        "Select",
        "Tabs",
        "Dialog",
        "DropdownMenu",
        "Tooltip",
        "Separator",
        "Heading",
        "Text",
        "Link",
        "Container",
        "Stack",
        "FormField",
        "Center",
        "Cluster",
        "Sidebar",
        "AspectRatio",
        "Combobox",
        "DatePicker",
        "NumberField",
        "Slider",
        "FileUpload"
      ],
      "additionalProperties": false,
      "properties": {
        "Button": { "$ref": "#/$defs/component" },
        "Input": { "$ref": "#/$defs/component" },
        "Textarea": { "$ref": "#/$defs/component" },
        "Card": { "$ref": "#/$defs/component" },
        "Badge": { "$ref": "#/$defs/component" },
        "Checkbox": { "$ref": "#/$defs/component" },
        "RadioGroup": { "$ref": "#/$defs/component" },
        "Switch": { "$ref": "#/$defs/component" },
        "Select": { "$ref": "#/$defs/component" },
        "Tabs": { "$ref": "#/$defs/component" },
        "Dialog": { "$ref": "#/$defs/component" },
        "DropdownMenu": { "$ref": "#/$defs/component" },
        "Tooltip": { "$ref": "#/$defs/component" },
        "Separator": { "$ref": "#/$defs/component" },
        "Heading": { "$ref": "#/$defs/component" },
        "Text": { "$ref": "#/$defs/component" },
        "Link": { "$ref": "#/$defs/component" },
        "Container": { "$ref": "#/$defs/component" },
        "Stack": { "$ref": "#/$defs/component" },
        "FormField": { "$ref": "#/$defs/component" },
        "Center": { "$ref": "#/$defs/component" },
        "Cluster": { "$ref": "#/$defs/component" },
        "Sidebar": { "$ref": "#/$defs/component" },
        "AspectRatio": { "$ref": "#/$defs/component" },
        "Combobox": { "$ref": "#/$defs/component" },
        "DatePicker": { "$ref": "#/$defs/component" },
        "NumberField": { "$ref": "#/$defs/component" },
        "Slider": { "$ref": "#/$defs/component" },
        "FileUpload": { "$ref": "#/$defs/component" },
        "Grid": { "$ref": "#/$defs/component" },
        "Section": { "$ref": "#/$defs/component" },
        "Fieldset": { "$ref": "#/$defs/component" },
        "Alert": { "$ref": "#/$defs/component" },
        "Progress": { "$ref": "#/$defs/component" },
        "Skeleton": { "$ref": "#/$defs/component" },
        "Toast": { "$ref": "#/$defs/component" },
        "Accordion": { "$ref": "#/$defs/component" },
        "Avatar": { "$ref": "#/$defs/component" },
        "Breadcrumbs": { "$ref": "#/$defs/component" },
        "Pagination": { "$ref": "#/$defs/component" },
        "Table": { "$ref": "#/$defs/component" },
        "Metric": { "$ref": "#/$defs/component" },
        "DescriptionList": { "$ref": "#/$defs/component" },
        "Timeline": { "$ref": "#/$defs/component" },
        "Meter": { "$ref": "#/$defs/component" },
        "EmptyState": { "$ref": "#/$defs/component" }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "The canonical capability-category inventory generated into every manifest. It is a category-membership reference only, not a second availability declaration: whether a component is available is determined exclusively by the names present in `components`.",
      "required": ["categories"],
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "object",
          "description": "Exactly the canonical categories, each with its fixed required/optional membership in canonical order. Values are generated from one canonical definition in scripts/design-system-manifest.mjs and are never declared in a package-owned source descriptor.",
          "required": ["composition", "forms", "data-display"],
          "additionalProperties": false,
          "properties": {
            "composition": {
              "type": "object",
              "description": "Layout and composition components.",
              "required": ["required", "optional"],
              "additionalProperties": false,
              "properties": {
                "required": {
                  "const": ["Container", "Stack", "Center", "Cluster", "Sidebar", "AspectRatio"],
                  "description": "The exact required composition components, in canonical order."
                },
                "optional": {
                  "const": ["Grid", "Section"],
                  "description": "The exact optional composition components, in canonical order. A system that does not implement one simply omits it from `components`."
                }
              }
            },
            "forms": {
              "type": "object",
              "description": "Form and input components.",
              "required": ["required", "optional"],
              "additionalProperties": false,
              "properties": {
                "required": {
                  "const": [
                    "FormField",
                    "Combobox",
                    "DatePicker",
                    "NumberField",
                    "Slider",
                    "FileUpload"
                  ],
                  "description": "The exact required form components, in canonical order."
                },
                "optional": {
                  "const": [],
                  "description": "The exact optional form components, in canonical order; currently none."
                }
              }
            },
            "data-display": {
              "type": "object",
              "description": "Data display and feedback components.",
              "required": ["required", "optional"],
              "additionalProperties": false,
              "properties": {
                "required": {
                  "const": [],
                  "description": "The exact required data-display components, in canonical order; currently none."
                },
                "optional": {
                  "const": [
                    "Table",
                    "Pagination",
                    "Progress",
                    "Metric",
                    "DescriptionList",
                    "Timeline",
                    "Meter",
                    "EmptyState"
                  ],
                  "description": "The exact optional data-display components, in canonical order. A system that does not implement one simply omits it from `components`."
                }
              }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "description": "Semantic design metadata (no token values).",
      "required": ["density", "theme", "radius", "keywords"],
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "theme": { "enum": ["light-first", "dark-first", "dual"] },
        "radius": { "enum": ["none", "small", "medium", "large", "full"] },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "Strict usage rules a consumer must respect.",
      "required": [
        "allowArbitraryColors",
        "allowArbitraryRadius",
        "allowArbitraryShadows",
        "allowPrimitiveDuplication"
      ],
      "additionalProperties": false,
      "properties": {
        "allowArbitraryColors": { "type": "boolean" },
        "allowArbitraryRadius": { "type": "boolean" },
        "allowArbitraryShadows": { "type": "boolean" },
        "allowPrimitiveDuplication": { "type": "boolean" }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Flattened semantic token names (never values) grouped by token group, package-relative artifact paths, and the naming contract consumers read from the manifest only (`names.cssVariablePrefix` for CSS custom properties, `names.tailwindUtilityPrefix` for Tailwind utilities).",
      "required": ["groups", "artifacts", "names"],
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "object",
          "description": "The canonical token naming contract, derived by the generator from the same constants the CSS and Tailwind artifacts use. Readers must use these values from the manifest instead of guessing prefixes; both fields are safe lower-kebab namespaces.",
          "required": ["cssVariablePrefix", "tailwindUtilityPrefix"],
          "additionalProperties": false,
          "properties": {
            "cssVariablePrefix": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "description": "Prefix of every CSS custom property the package stylesheet defines, e.g. `maivand-a` for `--maivand-a-color-text-primary`."
            },
            "tailwindUtilityPrefix": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "description": "Namespace of every semantic Tailwind theme key the bridge aliases, e.g. `prism` for `--color-prism-text-primary`."
            }
          }
        },
        "groups": {
          "type": "object",
          "required": [
            "themes",
            "typography",
            "spacing",
            "containers",
            "breakpoints",
            "layers",
            "radius",
            "shadow",
            "motion"
          ],
          "additionalProperties": false,
          "properties": {
            "themes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "typography": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "spacing": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "containers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "breakpoints": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "layers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "radius": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "shadow": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "motion": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "artifacts": {
          "type": "object",
          "required": ["typescript", "css", "tailwind"],
          "additionalProperties": false,
          "properties": {
            "typescript": { "type": "string", "pattern": "^\\./.+" },
            "css": { "type": "string", "pattern": "^\\./.+" },
            "tailwind": { "type": "string", "pattern": "^\\./.+" }
          }
        }
      }
    },
    "docs": {
      "type": "object",
      "description": "Package-relative documentation paths.",
      "required": ["readme", "agents"],
      "additionalProperties": false,
      "properties": {
        "readme": { "type": "string", "pattern": "^\\./.+" },
        "agents": { "type": "string", "pattern": "^\\./.+" },
        "brief": { "type": "string", "pattern": "^\\./.+" },
        "foundations": { "type": "string", "pattern": "^\\./.+" },
        "components": { "type": "string", "pattern": "^\\./.+" },
        "usage": { "type": "string", "pattern": "^\\./.+" }
      }
    }
  },
  "$defs": {
    "effects": {
      "type": "object",
      "description": "Explicit visual-effects declaration copied from the source descriptor. Missing means undeclared. `fallback` is only meaningful for webgl/mixed rendering, and a `3d` feature requires webgl or mixed rendering (CSS depth is not WebGL).",
      "required": ["features", "rendering", "reducedMotion"],
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["depth", "motion", "3d"] }
        },
        "rendering": { "enum": ["dom", "webgl", "mixed"] },
        "reducedMotion": { "type": "boolean" },
        "fallback": { "enum": ["static", "none"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "rendering": { "const": "dom" } },
            "required": ["rendering"]
          },
          "then": { "not": { "required": ["fallback"] } }
        },
        {
          "if": {
            "properties": { "features": { "contains": { "const": "3d" } } },
            "required": ["features"]
          },
          "then": {
            "properties": { "rendering": { "enum": ["webgl", "mixed"] } }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "description": "One package requirement for an entrypoint, resolved from package.json. The kind is exactly dependency or peer; optional mirrors optionalDependencies or peerDependenciesMeta.",
      "required": ["name", "kind", "range", "optional"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["dependency", "peer"] },
        "range": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["requirements"],
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        }
      }
    },
    "extension": {
      "type": "object",
      "description": "One verified custom extension: a PascalCase runtime named export of a declared code entrypoint, with real packaged docs/example references and an apiVersion.",
      "required": ["apiVersion", "entrypoint", "description", "docs", "example"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": { "type": "integer", "minimum": 1 },
        "entrypoint": {
          "type": "string",
          "pattern": "^(?:\\.|\\./(?:[a-z0-9][a-z0-9-]*)(?:/[a-z0-9][a-z0-9-]*)*)$"
        },
        "description": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "pattern": "^\\./.+" },
        "example": { "type": "string", "pattern": "^\\./.+" },
        "effects": { "$ref": "#/$defs/effects" }
      }
    },
    "component": {
      "type": "object",
      "required": ["variants", "sizes", "members"],
      "additionalProperties": false,
      "properties": {
        "variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sizes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "effects": { "$ref": "#/$defs/effects" },
        "description": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 }
      }
    }
  }
}
