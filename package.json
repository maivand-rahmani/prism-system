{
  "name": "maivand-design-systems",
  "version": "0.4.0",
  "private": true,
  "description": "Portable, independently versioned design systems for Maivand products.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/test-unit.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ds:create": "node scripts/create-design-system.mjs",
    "ds:register": "node scripts/register-design-system.mjs",
    "ds:check": "node scripts/validate-design-system.mjs",
    "ds:manifest": "node scripts/design-system-manifest.mjs",
    "ds:sync-versions": "node scripts/sync-design-system-versions.mjs",
    "ds:connect": "node scripts/connect-design-system.mjs",
    "ds:check-usage": "node scripts/check-design-system-usage.mjs",
    "ds:check-tools": "node scripts/check-tools.mjs",
    "ds:check-docs": "node scripts/check-docs.mjs",
    "ds:check-all": "node scripts/check-all.mjs",
    "ds:release": "node scripts/prepare-release.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "version-packages-and-sync": "pnpm version-packages && pnpm ds:sync-versions",
    "release": "node scripts/sync-design-system-versions.mjs --check && turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
