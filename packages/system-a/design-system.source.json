  "design": {
    "density": "comfortable",
    "theme": "light-first",
    "radius": "small",
    "keywords": [
      "calm",
      "minimal",
      "editorial",
      "warm light surfaces",
      "ink-led hierarchy",
      "quiet borders",
      "restrained motion",
      "low visual noise"
    ]
  },
  "rules": {
    "allowArbitraryColors": false,
    "allowArbitraryRadius": false,
    "allowArbitraryShadows": false,
    "allowPrimitiveDuplication": false
  },
  "docs": {
    "readme": "./README.md",
    "agents": "./AGENTS.md"
  }
