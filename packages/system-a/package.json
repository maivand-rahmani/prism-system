{
  "name": "@prism-system/ui-system-a",
  "version": "3.0.0",
  "description": "A calm, focused design system for clear editorial product interfaces, built on @prism-system/ui-core.",
  "prismSystem": {
    "name": "System A",
    "contractVersion": 4,
    "uiClass": "maivand-a-ui",
    "tokensExport": "systemATokens"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maivand-rahmani/prism-system"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./manifest": "./design-system.json"
  },
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "AGENTS.md",
    "design-system.json",
    "design-brief.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/tokens/index.ts --format esm,cjs --dts --clean && node -e \"require('node:fs').copyFileSync('src/styles/tailwind.css','dist/tailwind.css')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "node --test accordion-navigation.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@prism-system/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
