{
  "name": "@prism-system/tools",
  "version": "2.0.0",
  "description": "Published tooling for @prism-system design systems: search and inspect the npm registry (read-only), explicitly install (npm/pnpm), and configure/validate consumers with prism-ds. No postinstall, no source copying, no publishing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maivand-rahmani/prism-system"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "prism-ds": "./bin/prism-ds.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
