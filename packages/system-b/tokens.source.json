{
  "$schema": "https://github.com/maivand-rahmani/prism-system/schemas/tokens.source.schema.json",
  "schemaVersion": 1,
  "themes": {
    "light": {
      "color": {
        "text": {
          "primary": "#fff7e8",
          "secondary": "#d9cfe0",
          "muted": "#c4b8cf",
          "inverse": "#170f14"
        },
        "surface": {
          "canvas": "#111016",
          "raised": "#1a1720",
          "sunken": "#2a2432",
          "inverse": "#fff7e8"
        },
        "border": {
          "default": "#51445d",
          "strong": "#756780",
          "focus": "#6ee7ff"
        },
        "action": {
          "primary": "#ff5b4d",
          "primaryHover": "#ff786b",
          "primaryText": "#170f14",
          "secondary": "#39242a",
          "secondaryHover": "#4a2d34",
          "secondaryText": "#ff786b"
        },
        "status": {
          "info": "#6ee7ff",
          "success": "#5ee6a8",
          "warning": "#ffd166",
          "danger": "#ff4365"
        }
      }
    },
    "dark": {
      "color": {
        "text": {
          "primary": "#fff7e8",
          "secondary": "#d9cfe0",
          "muted": "#c4b8cf",
          "inverse": "#170f14"
        },
        "surface": {
          "canvas": "#111016",
          "raised": "#1a1720",
          "sunken": "#2a2432",
          "inverse": "#fff7e8"
        },
        "border": {
          "default": "#51445d",
          "strong": "#756780",
          "focus": "#6ee7ff"
        },
        "action": {
          "primary": "#ff5b4d",
          "primaryHover": "#ff786b",
          "primaryText": "#170f14",
          "secondary": "#39242a",
          "secondaryHover": "#4a2d34",
          "secondaryText": "#ff786b"
        },
        "status": {
          "info": "#6ee7ff",
          "success": "#5ee6a8",
          "warning": "#ffd166",
          "danger": "#ff4365"
        }
      }
    }
  },
  "typography": {
    "family": {
      "sans": "\"Space Grotesk\", \"Arial Narrow\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "size": {
      "xs": "0.6875rem",
      "sm": "0.75rem",
      "md": "0.875rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "2.5rem"
    },
    "weight": {
      "light": 300,
      "normal": 400,
      "medium": 500,
      "semibold": 650,
      "bold": 750
    },
    "lineHeight": {
      "tight": 1.15,
      "normal": 1.4,
      "relaxed": 1.6
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.06em"
    }
  },
  "spacing": {
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "semantic": {
      "inline": "12px",
      "inset": "20px",
      "stack": { "$ref": "spacing.scale.4" },
      "section": "48px"
    }
  },
  "containers": {
    "narrow": "40rem",
    "content": "64rem",
    "wide": "80rem",
    "full": "100%"
  },
  "breakpoints": {
    "sm": "40rem",
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem"
  },
  "layers": {
    "base": 0,
    "dropdown": 60,
    "sticky": 30,
    "overlay": 50,
    "modal": 51,
    "toast": 70,
    "tooltip": 80
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "14px",
    "full": "999px"
  },
  "shadow": {
    "sm": "3px 3px 0 rgba(255, 91, 77, 0.28)",
    "md": "8px 8px 0 rgba(0, 0, 0, 0.38)",
    "lg": "12px 12px 0 rgba(0, 0, 0, 0.42)",
    "focus": "0 0 0 3px rgba(110, 231, 255, 0.45)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "260ms",
      "slow": "400ms",
      "reduced": "1ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.16, 1, 0.3, 1)",
      "entrance": { "$ref": "motion.easing.standard" },
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  }
}
