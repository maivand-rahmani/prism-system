{
  "name": "@prism-system/ui-system-b",
  "version": "4.0.0",
  "description": "A contrasty, expressive design system for editorial interfaces, built on @prism-system/ui-core.",
  "license": "MIT",
  "prismSystem": {
    "name": "System B",
    "contractVersion": 4,
    "uiClass": "maivand-b-ui",
    "tokensExport": "systemBTokens"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maivand-rahmani/prism-system"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./custom/keyboard-scene": {
      "types": "./dist/custom/keyboard-scene/index.d.ts",
      "import": "./dist/custom/keyboard-scene/index.mjs",
      "require": "./dist/custom/keyboard-scene/index.js"
    },
    "./custom/interactive-workflow-map": {
      "types": "./dist/custom/interactive-workflow-map/index.d.ts",
      "import": "./dist/custom/interactive-workflow-map/index.mjs",
      "require": "./dist/custom/interactive-workflow-map/index.js"
    },
    "./manifest": "./design-system.json"
  },
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "AGENTS.md",
    "docs/extensions",
    "examples",
    "design-system.json",
    "design-brief.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/copy-tailwind.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": "^0.186.1",
    "@react-three/fiber": "^8.18.0 || ^9.8.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "dependencies": {
    "@prism-system/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
