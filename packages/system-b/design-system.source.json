{
  "$schema": "https://github.com/maivand-rahmani/prism-system/schemas/design-system.source.schema.json",
  "schemaVersion": 4,
  "contractVersion": 4,
  "name": "System B",
  "components": {
    "Button": {
      "variants": ["primary", "secondary", "outline", "ghost", "destructive", "link"],
      "sizes": ["sm", "md", "lg", "icon"],
      "members": [],
      "effects": {
        "features": ["depth", "motion"],
        "rendering": "dom",
        "reducedMotion": true
      }
    },
    "Input": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": []
    },
    "Textarea": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": []
    },
    "Card": {
      "variants": ["default", "muted", "outline", "elevated", "interactive"],
      "sizes": [],
      "members": ["Header", "Title", "Description", "Content", "Footer"]
    },
    "Badge": {
      "variants": ["default", "secondary", "success", "warning", "danger", "info", "outline"],
      "sizes": ["sm", "md"],
      "members": []
    },
    "Checkbox": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": []
    },
    "RadioGroup": {
      "variants": [],
      "sizes": [],
      "members": ["Item", "Indicator"]
    },
    "Switch": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": ["Thumb"]
    },
    "Select": {
      "variants": [],
      "sizes": ["sm", "md", "lg"],
      "members": ["Trigger", "Value", "Content", "Group", "Label", "Item", "Separator"]
    },
    "Tabs": {
      "variants": [],
      "sizes": [],
      "members": ["List", "Trigger", "Content"]
    },
    "Dialog": {
      "variants": [],
      "sizes": [],
      "members": [
        "Trigger",
        "Portal",
        "Overlay",
        "Content",
        "Header",
        "Footer",
        "Title",
        "Description",
        "Close"
      ]
    },
    "DropdownMenu": {
      "variants": [],
      "sizes": [],
      "members": [
        "Trigger",
        "Portal",
        "Content",
        "Group",
        "Label",
        "Item",
        "CheckboxItem",
        "RadioGroup",
        "RadioItem",
        "ItemIndicator",
        "Separator",
        "Arrow",
        "Sub",
        "SubTrigger",
        "SubContent"
      ]
    },
    "Tooltip": {
      "variants": [],
      "sizes": [],
      "members": ["Provider", "Trigger", "Portal", "Content", "Arrow"]
    },
    "Separator": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Heading": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Text": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Link": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Container": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Stack": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "FormField": {
      "variants": [],
      "sizes": [],
      "members": ["Label", "Control", "Description", "Error"]
    },
    "Center": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Cluster": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Sidebar": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "AspectRatio": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Combobox": {
      "variants": [],
      "sizes": [],
      "members": ["Input", "Content", "Item"]
    },
    "DatePicker": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "NumberField": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Slider": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "FileUpload": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Section": {
      "variants": [],
      "sizes": [],
      "members": ["Header", "Title", "Description", "Content", "Footer"]
    },
    "Alert": {
      "variants": ["info", "success", "warning", "danger"],
      "sizes": [],
      "members": ["Title", "Description"]
    },
    "Skeleton": {
      "variants": [],
      "sizes": [],
      "members": []
    },
    "Toast": {
      "variants": [],
      "sizes": [],
      "members": ["Provider", "Viewport", "Root", "Title", "Description", "Action", "Close"]
    },
    "Avatar": {
      "variants": [],
      "sizes": [],
      "members": ["Image", "Fallback"]
    },
    "Breadcrumbs": {
      "variants": [],
      "sizes": [],
      "members": ["List", "Item", "Link", "Current"]
    },
    "Metric": {
      "variants": [],
      "sizes": [],
      "members": ["Label", "Value", "Description"]
    },
    "Timeline": {
      "variants": [],
      "sizes": [],
      "members": ["Item", "Title", "Time", "Description"]
    },
    "EmptyState": {
      "variants": [],
      "sizes": [],
      "members": ["Title", "Description", "Action"]
    }
  },
  "design": {
    "density": "compact",
    "theme": "dark-first",
    "radius": "small",
    "keywords": [
      "dark-first",
      "high-contrast",
      "expressive",
      "editorial",
      "physical motion",
      "electric accents"
    ]
  },
  "rules": {
    "allowArbitraryColors": false,
    "allowArbitraryRadius": false,
    "allowArbitraryShadows": false,
    "allowPrimitiveDuplication": false
  },
  "docs": {
    "readme": "./README.md",
    "agents": "./AGENTS.md",
    "usage": "./USAGE.md"
  },
  "entrypoints": {
    "./custom/keyboard-scene": {
      "source": "./src/custom/keyboard-scene/index.ts",
      "requires": ["three", "@react-three/fiber"]
    },
    "./custom/interactive-workflow-map": {
      "source": "./src/custom/interactive-workflow-map/index.ts",
      "requires": []
    }
  },
  "extensions": {
    "KeyboardScene": {
      "apiVersion": 1,
      "entrypoint": "./custom/keyboard-scene",
      "description": "A selectable procedural keyboard scene with persistent DOM controls and a static fallback.",
      "docs": "./docs/extensions/keyboard-scene.md",
      "example": "./examples/keyboard-scene.md",
      "effects": {
        "features": ["3d", "motion"],
        "rendering": "webgl",
        "reducedMotion": true,
        "fallback": "static"
      }
    },
    "InteractiveWorkflowMap": {
      "apiVersion": 1,
      "entrypoint": "./custom/interactive-workflow-map",
      "description": "A controlled, keyboard-accessible workflow path with responsive DOM layout.",
      "docs": "./docs/extensions/interactive-workflow-map.md",
      "example": "./examples/interactive-workflow-map.md",
      "effects": {
        "features": ["motion"],
        "rendering": "dom",
        "reducedMotion": true
      }
    }
  }
}
